# ============================================================
# Copy this file to .env in the project root, then edit it:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# The backend reads .env automatically on startup.
# Never commit .env or share it. It is listed in .gitignore.
# ============================================================

# Required for the AI assistant. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional. Use a model your key can access (run the model-list
# command in the README to see them).
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional upload limit in megabytes
MAX_UPLOAD_SIZE_MB=500
